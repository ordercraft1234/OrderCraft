# Live RPC. While empty, /slots/fetch answers 403 RPC_DISABLED and
# the app runs on the curated slot set from packages/fixtures.
SOLANA_RPC_URL=

# Frontend origin for CORS.
WEB_ORIGIN=http://localhost:5173

# Postgres (Supabase). DDL and migrations go through the session pooler (port 5432),
# runtime through the transaction pooler (port 6543). Role postgres, not anon.
DATABASE_URL=
DATABASE_URL_MIGRATE=

# API process (apps/api). Both optional.
PORT=8787
SLOT_CACHE_DIR=.cache/slots
