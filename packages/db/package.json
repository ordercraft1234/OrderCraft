  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.5.0",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
